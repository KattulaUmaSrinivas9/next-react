CHAT_QUEUE_REGION=iad1
# Local shared queue devserver. Do not set these in Vercel production.
VERCEL_QUEUE_BASE_URL=http://127.0.0.1:8111
VERCEL_QUEUE_TOKEN=local-token
NEXT_API_BASE_URL=http://localhost:3000
NEXT_CHAT_CALLBACK_SECRET=replace-with-the-same-secret-used-by-next
# Neon PostgreSQL connection string. Keep the real value in local .env / Vercel env settings only.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
