RABBITMQ_URL=amqp://guest:guest@localhost:5672/%2F
CHAT_REQUEST_QUEUE=chat.requests
CHAT_RESPONSE_EXCHANGE=chat.responses.fanout
CHAT_WORKER_PREFETCH=1
# Neon PostgreSQL connection string. Keep the real value in local .env / Vercel env settings only.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
